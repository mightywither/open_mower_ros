# Standalone image for the React/Vite web UI.
# Builds the frontend and serves the static files with nginx on port 8081.
# Deployed alongside (not replacing) the legacy OpenMowerApp, which stays on 8080.

FROM node:20-alpine AS build
WORKDIR /app
COPY src/mower_web_ui/frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY src/mower_web_ui/frontend/ ./
RUN npm run build

####################################################################################################

FROM nginx:alpine
COPY docker/assets/nginx-webui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8081
