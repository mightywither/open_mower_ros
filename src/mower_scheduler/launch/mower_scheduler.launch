<launch>
    <node pkg="mower_scheduler" type="mower_scheduler.py" name="mower_scheduler" output="screen" respawn="true" respawn_delay="10">
        <!-- MQTT broker (the same mosquitto the web UI and bridge use). -->
        <param name="broker_host" value="$(optenv OM_MQTT_HOST 127.0.0.1)"/>
        <param name="broker_port" value="$(optenv OM_MQTT_PORT 1883)"/>
    </node>
</launch>
